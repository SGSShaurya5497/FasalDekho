# Application Settings
APP_NAME=FasalDekho AI API
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL default, falls back to SQLite if unset)
DATABASE_URL=postgresql://postgres:postgres@db:5432/plant_disease

# JWT Authentication Secrets
JWT_SECRET_KEY=super-secret-jwt-key-change-this-in-production-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & File Upload Limits
MAX_UPLOAD_SIZE_MB=10
PREDICT_RATE_LIMIT=15/minute

# Model Paths
MODEL_PATH_PLANT_CLASSIFIER=
TOMATO_MODEL=../Models/Tomato_Model/Model_T_v2.h5
POTATO_MODEL=../Models/Potato_Model/Model_P_v5.h5
GRAPE_MODEL=../Models/Grap_Model/Model_G_v2.h5
CORN_MODEL=../Models/Corn_Model/Model_C_v4.h5
CONFIDENCE_THRESHOLD=0.70

